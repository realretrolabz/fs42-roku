<?xml version="1.0" encoding="utf-8" ?>

<!--
    MainScene is the only screen in this Roku app.
    It owns one Video node, the TV overlay, selectable control hotspots, and
    a live channel display rendered over the overlay's built-in display.
-->
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Video
            id="streamVideo"
            width="1280"
            height="960"
            enableUI="false"
            translation="[244, 57]" />

        <Poster
            id="tvOverlay"
            uri="pkg:/images/tv.png"
            width="1920"
            height="1080"
            translation="[0, 0]" />

        <Rectangle
            id="channelDisplayBacker"
            color="0x000000FF"
            width="124"
            height="88"
            translation="[1594, 139]" />
