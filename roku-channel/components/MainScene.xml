            id="channelDisplay"
            text="--"
            color="0xFF1A1AFF"
            width="124"
            height="88"
            horizAlign="center"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            translation="[1594, 139]" />

        <Rectangle
            id="powerFocus"
            color="0xC8C8C833"
            width="95"
            height="71"
            translation="[1609, 308]"
            visible="false" />
        <Rectangle
